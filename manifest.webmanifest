{
  "name": "Delivery Tracker",
  "short_name": "Deliveries",
  "description": "Track client delivery commitments against production and shipment, with alerts.",
  "id": "/",
  "start_url": "/#/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#172033",
  "theme_color": "#172033",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Deliveries", "url": "/#/deliveries", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Alerts", "url": "/#/alerts", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Timeline", "url": "/#/timeline", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
